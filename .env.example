# 複製成 .env.local 後填入。Local Mode 不需要 Firebase 設定。
# local = 資料存在瀏覽器 localStorage（開發用）；firebase = 連線到 Firebase
VITE_STORE_MODE=local

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 家庭帳號（主辦）的 UID，與 firestore.rules 裡的一致
VITE_FAMILY_UID=
